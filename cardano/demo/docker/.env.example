# Cardano <-> Sepolia demo environment.
#
#   cp .env.example .env
#
# Everything below is pre-filled against the live `preview` deployment recorded
# in cardano/deployments/preview/. You only need to supply BLOCKFROST_API_KEY.
#
# If the demo stops working, run ../scripts/preflight.sh -- the preview
# deployment is shared, mutable testnet state and can be spent out from under
# you. See ../../docs/DEPLOYMENT_GUIDE.md to deploy your own.

RUST_LOG=info

# Defaults for the `hyperlane-cardano` CLI, so its commands need no flags when
# run from cardano/. Each has a matching --flag if you prefer to be explicit.
CARDANO_NETWORK=preview

# =============================================================================
# THE ONE THING YOU MUST FILL IN
# =============================================================================
# Free key from https://blockfrost.io -- create a project on network "Preview".
BLOCKFROST_API_KEY=

# =============================================================================
# DEMO KEYS
# =============================================================================
# These are throwaway testnet keys, committed on purpose so the demo runs out of
# the box. They hold demo-level funds only. Anyone with this file can spend them
# and can re-configure the Sepolia contracts they own -- never reuse them for
# anything else, and never fund them beyond what a demo needs.

# Ed25519 Cardano key that pays for Cardano transactions (hex, 0x-prefixed).
# Same key as keys/cardano/payment.skey.
CARDANO_SIGNER_KEY=0xf5e5319e6f4403600791409af815d37996b5357b3f33905bba180a9783c7538e

# ECDSA secp256k1 key the validator signs Cardano checkpoints with.
CARDANO_VALIDATOR_KEY=0x2e0afff1080232cd5fc8fe769dd72f5766e4e0b66e5528fa93f80e75aca9e764

# Sepolia key that pays gas and owns the Sepolia-side contracts.
SEPOLIA_SIGNER_KEY=0x8ab7a00c32d023e31b7763e7d44d4868d82ecd618fd77a322c61783a57b02505

# cardano-cli signing key, as a path. Relative paths are resolved against
# cardano/ -- the directory the CLI examples are run from -- not against this
# file. Use an absolute path if you run the CLI from anywhere else.
CARDANO_SIGNING_KEY=demo/keys/cardano/payment.skey

# =============================================================================
# CARDANO PREVIEW -- deployed contracts
# =============================================================================
# H256 form (0x00000000 + 28-byte script hash) is what the agents read.
CARDANO_MAILBOX=0x00000000e86679a09d84a08d4963d245ae2f125954a403b33e88c5b286299f7d
CARDANO_VALIDATOR_ANNOUNCE=0x00000000ffa98d7f174b7075dbf2c5131a19cbc6864220e586a147c4ca806ba7
CARDANO_MERKLE_TREE_HOOK=0x00000000e86679a09d84a08d4963d245ae2f125954a403b33e88c5b286299f7d
CARDANO_ISM=0x00000000fc16a986e4a17c42e33228947cbaec6c6372e9c856fb796cd7d832cb
CARDANO_IGP=0x00000000061a6290caf75341ac9f4cd33aeb8be59b814666515c7c124bea26fb

# Raw 28-byte policy IDs, script hashes and reference-script UTXOs.
CARDANO_MAILBOX_POLICY_ID=e1f52d72aa804300057a128d5978db87db99457e07703cbae9c08c11
CARDANO_MAILBOX_SCRIPT_HASH=e86679a09d84a08d4963d245ae2f125954a403b33e88c5b286299f7d
CARDANO_MAILBOX_REF_UTXO=454eefb70fee559fd4a1ea14717c0931dcb903aa213215030095d50783ca2b84#0
CARDANO_ISM_SCRIPT_HASH=fc16a986e4a17c42e33228947cbaec6c6372e9c856fb796cd7d832cb
CARDANO_ISM_STATE_NFT_POLICY_ID=4e638ea91965084658aaf6919adfa6c4436c1a4120c8e89e1d286aa5
CARDANO_ISM_REF_UTXO=4569122c1b42a20dea00ac8283f20257e96f1aa180c902d379d41522b3872d58#0
CARDANO_VA_POLICY_ID=ffa98d7f174b7075dbf2c5131a19cbc6864220e586a147c4ca806ba7
CARDANO_VA_REF_UTXO=fe70d677b4a94194b6d656b5651d96c125f6cded85d18dfccc812cae0f7185fb#0
CARDANO_IGP_SCRIPT_HASH=061a6290caf75341ac9f4cd33aeb8be59b814666515c7c124bea26fb
CARDANO_IGP_STATE_NFT_POLICY_ID=a1cc544302f036fb61ec2233e8b348ef80b3a24b43bf6884cfdb5b39
CARDANO_WARP_ROUTE_REF_UTXO=943e4fceda10aed044d6a9576564ca69c5d4f82906ff00111fafe194d2aa404c#1

# The verified-message NFT is parameterized by the mailbox and vice versa, so
# both values must be regenerated whenever the mailbox is redeployed. A stale
# pair makes every inbound delivery fail with a bare Plutus error.
CARDANO_VERIFIED_MSG_NFT_POLICY_ID=6117b55d586af613927e18bcbf8d1d7d7c7caeb0d35c5ad8b0c76d91
CARDANO_VERIFIED_MSG_NFT_SCRIPT_

# Block to start indexing from. Lower is slower; never set it above the block
# the mailbox was deployed in or the agents will miss its state.
CARDANO_INDEX_FROM=4542208

# =============================================================================
# SEPOLIA -- Hyperlane core (official deployment)
# =============================================================================
# drpc's free tier stopped serving Sepolia; publicnode still does.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_MAILBOX=0xfFAEF09B3cd11D9b20d1a19bECca54EEC2884766
SEPOLIA_VALIDATOR_ANNOUNCE=0xE6105C59480a1B7DD3E4f28153aFdbE12F4CfCD9
SEPOLIA_MERKLE_TREE_HOOK=0x4917a9746A7B6E0A57159cCb7F5a6744247f2d0d
SEPOLIA_INDEX_FROM=11437203

# Deployed by cardano/demo/solidity/: an ISM that trusts our Cardano validator,
# an IGP + oracle priced for Cardano, and an aggregation hook wiring both.
SEPOLIA_ISM=0x6Dd82460b483851de3A2fA64DF005cF89EAb8937
SEPOLIA_IGP=0x5aC1BCA88fd8416C6cC2D29A832EEDA75dfF6424
SEPOLIA_STORAGE_GAS_ORACLE=0xe570005d46d8379F2119e92E9d6d8Ac83735546D
SEPOLIA_AGGREGATION_HOOK=0xeF7B2092DF766152b4f314d0ED9bC5980F1Bd2B2

# =============================================================================
# DEMO WARP ROUTE -- ADA on Cardano, wADA on Sepolia
# =============================================================================
# One route, enrolled in both directions. Both sides use 6 decimals and the
# Cardano route is deployed with --remote-decimals 6, so the wire amount is
# lovelace and nothing is rescaled. Redeploying one side with different
# decimals without matching the other silently corrupts every transfer amount.
CARDANO_NATIVE_WARP_ROUTE=0x01000000450d958838c51d88c532c934bb3943e09b3e08ef12c2b4eb9b1670ce
CARDANO_NATIVE_WARP_NFT_POLICY=450d958838c51d88c532c934bb3943e09b3e08ef12c2b4eb9b1670ce
SEPOLIA_SYNTHETIC_WADA=0x127AB2b2c5B8d9ae757c8Cf0c3Fe76c5EdE49F78

# =============================================================================
# LOCAL SERVICES
# =============================================================================
# Scraper Postgres + the Hasura GraphQL API hyperlane-explorer reads.
# Local-only; docker-compose defaults to these if unset.
POSTGRES_PASSWORD=47221c18c610
HASURA_ADMIN_SECRET=hyperlane
