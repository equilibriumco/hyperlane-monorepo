# Copy to .env and fill in. Everything here is passed to the agents wholesale,
# so this file is the single place addresses live.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Paths to the Midnight side
# ---------------------------------------------------------------------------
# Checkout of the midnight-hyperlane repo. Bind mounted into the agents because
# the Midnight submitter is `npx tsx` over its sources; `npm install` must have
# been run there already.
MIDNIGHT_REPO=/home/you/workspace/midnight-hyperlane
# Stagenet state written by the deploy tooling (addresses.json, private-state).
# Must survive stagenet resets — the maintenance-authority signing key for a
# chunk-deployed contract lives here.
MIDNIGHT_STATE_DIR_HOST=/home/you/.midnight-stagenet-test

# ---------------------------------------------------------------------------
# Midnight stagenet
# ---------------------------------------------------------------------------
# `stagenet` repoints the submitter's endpoints, seeds and network id. Omitting
# it silently falls back to devnet defaults: dry runs still pass (they use the
# request payload) while submits hang forever against a dead endpoint.
MIDNIGHT_NETWORK=stagenet
# Read by the Rust side, which has its own variable for the same thing.
MIDNIGHT_NETWORK_ID=stagenet
MIDNIGHT_INDEXER_URL=https://indexer.stagenet.shielded.tools/api/v3/graphql
# Two names, one endpoint: the Rust chain crate reads MIDNIGHT_NODE_RPC_URL,
# the TypeScript submitter reads MIDNIGHT_NODE_URL. Keep them in sync.
MIDNIGHT_NODE_RPC_URL=wss://rpc.stagenet.shielded.tools
MIDNIGHT_NODE_URL=wss://rpc.stagenet.shielded.tools
# Relayer's Midnight wallet (64 hex chars, no 0x). Required on stagenet.
MIDNIGHT_RELAYER_SEED=
# A handle proof takes minutes; the 120s default kills it mid-proof.
MIDNIGHT_SUBMIT_TIMEOUT_SECS=1800
# Proof server job TTL in seconds. Must exceed the slowest proof or the worker
# drops the finished job and the caller gets a 500.
PROOF_SERVER_JOB_TIMEOUT=14400

# Midnight contract addresses, from $MIDNIGHT_STATE_DIR_HOST/addresses.json.
MIDNIGHT_MAILBOX=
MIDNIGHT_MERKLE_TREE_HOOK=
MIDNIGHT_IGP=
MIDNIGHT_VALIDATOR_ANNOUNCE=
# 0 replays the whole chain. Set to the mailbox deployment block once known.
MIDNIGHT_INDEX_FROM=0

# ---------------------------------------------------------------------------
# Cardano preview
# ---------------------------------------------------------------------------
BLOCKFROST_API_KEY=
CARDANO_BLOCKFROST_URL=https://cardano-preview.blockfrost.io/api/v0
# Wallet that pays for announces and deliveries.
CARDANO_SIGNER_KEY=

# MUST be at or before the block the mailbox was deployed in. Set it later and
# the relayer never sees the tree's first leaves, so it sits at merkle index 0
# and delivers nothing.
CARDANO_INDEX_FROM=

# Hyperlane-format addresses (0x + kind byte + 3 zero bytes + 28-byte hash).
CARDANO_MAILBOX=
CARDANO_MERKLE_TREE_HOOK=
CARDANO_ISM=
CARDANO_IGP=
CARDANO_VALIDATOR_ANNOUNCE=

# Policy ids, script hashes and reference-script UTxOs, from the deploy output.
CARDANO_MAILBOX_POLICY_ID=
CARDANO_MAILBOX_SCRIPT_HASH=
CARDANO_MAILBOX_REF_UTXO=
CARDANO_ISM_STATE_NFT_POLICY_ID=
CARDANO_ISM_SCRIPT_HASH=
CARDANO_ISM_REF_UTXO=
CARDANO_VA_POLICY_ID=
CARDANO_VA_REF_UTXO=
CARDANO_IGP_SCRIPT_HASH=
CARDANO_WARP_ROUTE_REF_UTXO=
CARDANO_VERIFIED_MSG_NFT_POLICY_ID=
CARDANO_VERIFIED_MSG_NFT_SCRIPT_CBOR=

# ---------------------------------------------------------------------------
# Validators
# ---------------------------------------------------------------------------
# Two per origin, threshold 2 on each side. Checkpoint digests are
# origin-domain separated, so the same pair may be reused across both origins.
# The Cardano-origin pair must be trusted by Midnight's ISM; the
# Midnight-origin pair by the Cardano ISM's entry for domain 1234.
#
# Decide these BEFORE deploying on Midnight: the night contract enrols its
# validator set at deploy time (VALIDATOR_i_PUBKEY on stagenet), so changing your
# mind later means redeploying rather than reconfiguring.
#
# Throwaway testing keys live in `keys/` and are committed on purpose — they are
# for this test bridge only and must never hold value or be reused anywhere else.
# Each `keys/validator-<name>.key` has a matching `.addr` with the address the
# ISM and Midnight's validator set need. Copy the key values in below (or
# `keys/load-into-env.sh`).
CARDANO_VALIDATOR_KEY_1=
CARDANO_VALIDATOR_KEY_2=
MIDNIGHT_VALIDATOR_KEY_1=
MIDNIGHT_VALIDATOR_KEY_2=
# Seconds to hold back the second Cardano validator so its announce does not
# collide with the first on the shared wallet's collateral UTxOs.
CARDANO_VALIDATOR_STAGGER_SECS=90

# ---------------------------------------------------------------------------
# Validator checkpoints (S3)
# ---------------------------------------------------------------------------
# All four validators write their checkpoints to S3, one folder per validator.
#
# The two sides of this are asymmetric in a way that matters: validators WRITE
# with these credentials, but the relayer READS anonymously. So the bucket must
# allow public reads, or the relayer fetches no metadata and delivers nothing
# even though the validators look healthy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
CHECKPOINT_S3_BUCKET=
CHECKPOINT_S3_REGION=eu-north-1
# Folders are <prefix>/cardano-1, <prefix>/midnight-1, and so on. Bump the
# prefix after redeploying a mailbox: checkpoints under the old prefix describe
# a different merkle tree, and a validator resuming onto them signs nonsense.
CHECKPOINT_S3_PREFIX=

# ---------------------------------------------------------------------------
# Relayer behaviour
# ---------------------------------------------------------------------------
# Senders must pay the origin IGP, and the payment must cover gasFraction of
# what the destination estimates delivery will cost. This needs three things per
# direction, or messages are indexed and then never delivered:
#
#   1. A gas oracle registered on the ORIGIN IGP for the DESTINATION domain, so
#      quotes are non-zero. Cardano: `igp set-oracle --domain 1234 ...`, check
#      with `igp quote --domain 1234 --gas-limit N`. Midnight: the IGP's
#      owner-gated `setRemoteGasData` for domain 2003, check `isRegistered`.
#   2. Sends that actually pay. Cardano `warp transfer` only builds the atomic
#      IGP payment when `--gas-limit` is passed; without it nothing is paid.
#   3. Enough paid: the policy compares the payment's gas amount against
#      gasFraction x the destination's estimated gas limit.
#
# 1/1 requires the full estimate. Upstream's default is 1/2, which leaves slack
# for a destination estimate that drifts up after dispatch.
#
# For bring-up before the oracles are set, use '[{"type": "none"}]' — it skips
# the payment requirement entirely.
GAS_ENFORCEMENT='[{"type": "onChainFeeQuoting", "gasFraction": "1/1"}]'

# ---------------------------------------------------------------------------
# Scraper / explorer
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=47221c18c610
HASURA_ADMIN_SECRET=hyperlane
LOG_LEVEL=info
RUST_LOG=info

# Only needed for `docker compose --profile explorer up`. Checkout of the
# hyperlane-explorer repo on a branch carrying both protocols; `pnpm install`
# must have been run there.
EXPLORER_REPO=/home/you/workspace/hyperlane-explorer
# Registry the explorer reads chain metadata and warp routes from. Must contain
# both chains, or they degrade to ProtocolType.Unknown and lose address
# formatting, the timeline and the warp sections.
NEXT_PUBLIC_REGISTRY_URL=https://github.com/equilibriumco/hyperlane-registry
NEXT_PUBLIC_REGISTRY_BRANCH=midnight-cardano
