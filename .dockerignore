# Dependencies & build caches
node_modules
.pnpm-store/
pnpm-debug.log*
**/dist
**/.turbo

# Git & IDE
.github
.idea
.DS_STORE

# Directories not used in Docker images
rust
!rust/main
!rust/sealevel
# Cargo build output is never copied into the image, but without this the
# daemon walks it on every build -- it reaches tens of gigabytes locally.
rust/main/target
rust/sealevel/target
docs
tools
vectors
.claude
.changeset

# Test & coverage artifacts
**/coverage
**/__snapshots__

# Environment & temp files
**/.env
test_deploy.env
tmp.env
**/tmp.*
**/*.swp
**/*.swo

# TypeScript build info
**/tsconfig.tsbuildinfo
